---
import { projects } from '../data.js';

const featured = projects.filter(p => ['tfm-mri','mot16','deepfakes','enzyme'].includes(p.id));
const others   = projects.filter(p => !['tfm-mri','mot16','deepfakes','enzyme'].includes(p.id));

const images = {
  'tfm-mri':   '/project-tfm.png',
  'mot16':     '/project-mot16.png',
  'deepfakes': '/project-deepfakes.png',
  'enzyme':    '/project-enzyme.png',
};
---

<section id="projects">
  <p class="label reveal" id="label-projects">Projects</p>

  <!-- Featured grid -->
  <div class="featured-grid">
    {featured.map((p, i) => (
      <a
        href={p.github || '#'}
        target={p.github ? '_blank' : '_self'}
        rel="noopener"
        class="feat-card reveal"
        style={`transition-delay: ${i * 60}ms`}
        data-title-es={p.titleEs}
        data-title-en={p.titleEn}
        data-desc-es={p.descEs}
        data-desc-en={p.descEn}
        data-domain-es={p.domainEs}
        data-domain-en={p.domainEn}
      >
        <div class="feat-img-wrap">
          <img src={images[p.id]} alt={p.titleEn} class="feat-img" loading="lazy" />
          <div class="feat-img-overlay"></div>
        </div>
        <div class="feat-body">
          <p class="proj-domain mono proj-domain-text">{p.domainEn}</p>
          <p class="feat-title display proj-title-text">{p.titleEn}</p>
          <p class="feat-desc proj-desc-text">{p.descEn}</p>
          <div class="feat-footer">
            <span class={`proj-metric mono metric-${p.metricType}`}>{p.metric}</span>
            {p.featured && <span class="proj-badge mono" id={`badge-${p.id}`}>Finishing TFM</span>}
            {p.github   && <span class="feat-link mono">View on GitHub ↗</span>}
          </div>
        </div>
      </a>
    ))}
  </div>

  <!-- Other projects -->
  <div class="others-wrap reveal">
    <p class="label others-label" id="label-others">Other projects</p>
    <div class="others-grid">
      {others.map((p, i) => (
        <a
          href={p.github || '#'}
          target={p.github ? '_blank' : '_self'}
          rel="noopener"
          class={`other-card${!p.github ? ' no-link' : ''}`}
          data-title-es={p.titleEs}
          data-title-en={p.titleEn}
          data-desc-es={p.descEs}
          data-desc-en={p.descEn}
          data-domain-es={p.domainEs}
          data-domain-en={p.domainEn}
        >
          <p class="mono other-domain proj-domain-text">{p.domainEn}</p>
          <p class="other-title display proj-title-text">{p.titleEn}</p>
          <p class="other-desc proj-desc-text">{p.descEn}</p>
          <div class="other-footer">
            <span class={`proj-metric mono metric-${p.metricType}`}>{p.metric}</span>
            {p.collab && <span class="proj-collab mono" id={`collab-${p.id}`}>collab</span>}
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
/* ── Featured ── */
.featured-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.5rem;
  margin-bottom: 3rem;
}

.feat-card {
  border-radius: var(--radius);
  border: 0.5px solid var(--border);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  color: var(--ink);
  transition: border-color 0.2s, transform 0.2s;
  cursor: none;
}
.feat-card:hover {
  border-color: var(--border-2);
  transform: translateY(-2px);
}

.feat-img-wrap {
  position: relative;
  aspect-ratio: 16/9;
  overflow: hidden;
}
.feat-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}
.feat-card:hover .feat-img { transform: scale(1.03); }
.feat-img-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, transparent 50%, rgba(0,0,0,0.15) 100%);
}

.feat-body {
  padding: 1.25rem;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  flex: 1;
  background: var(--bg);
  transition: background 0.15s;
}
.feat-card:hover .feat-body { background: var(--bg-2); }

.proj-domain {
  font-size: 10px;
  color: var(--ink-3);
  letter-spacing: 0.1em;
  text-transform: uppercase;
}
.feat-title {
  font-size: 16px;
  font-weight: 700;
  line-height: 1.2;
}
.feat-desc {
  font-size: 12.5px;
  color: var(--ink-2);
  line-height: 1.55;
  flex: 1;
}
.feat-footer {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-wrap: wrap;
  margin-top: 0.5rem;
}
.feat-link {
  font-size: 10.5px;
  color: var(--ink-3);
  margin-left: auto;
  transition: color 0.15s;
}
.feat-card:hover .feat-link { color: var(--ink); }

/* ── Metrics & badges ── */
.proj-metric {
  font-size: 10.5px;
  padding: 3px 8px;
  border-radius: 3px;
  background: var(--bg-2);
  color: var(--ink-2);
}
.metric-accent { color: var(--accent); background: var(--accent-bg); }
.metric-blue   { color: var(--blue);  background: var(--blue-bg); }

.proj-badge {
  font-size: 10px;
  padding: 3px 8px;
  border-radius: 3px;
  background: var(--accent);
  color: #fff;
  letter-spacing: 0.06em;
}
.proj-collab {
  font-size: 10px;
  padding: 3px 8px;
  border-radius: 3px;
  background: var(--bg-2);
  color: var(--ink-3);
  border: 0.5px solid var(--border);
}

/* ── Others ── */
.others-wrap {
  border: 0.5px solid var(--border);
  border-radius: var(--radius);
  padding: 1.5rem;
  margin-bottom: 5rem;
}
.others-label {
  margin-bottom: 1.25rem;
  font-size: 11px;
}
.others-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1px;
  background: var(--border);
  border-radius: calc(var(--radius) - 4px);
  overflow: hidden;
}
.other-card {
  background: var(--bg);
  padding: 1.1rem;
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  color: var(--ink);
  transition: background 0.15s;
  cursor: none;
}
.other-card:hover { background: var(--bg-2); }
.other-card.no-link { cursor: default; }

.other-domain {
  font-size: 9.5px;
  color: var(--ink-3);
  letter-spacing: 0.1em;
  text-transform: uppercase;
}
.other-title {
  font-size: 13px;
  font-weight: 700;
  line-height: 1.2;
}
.other-desc {
  font-size: 11.5px;
  color: var(--ink-2);
  line-height: 1.5;
  flex: 1;
}
.other-footer {
  display: flex;
  gap: 0.4rem;
  flex-wrap: wrap;
  margin-top: 4px;
}

@media (max-width: 700px) {
  .featured-grid  { grid-template-columns: 1fr; }
  .others-grid    { grid-template-columns: 1fr; }
}
</style>
