---
import { personal } from '../data.js';
---
<section id="contact">
  <p class="label reveal" id="label-contact">Contact</p>

  <div class="contact-block reveal hoverable">
    <p class="mono contact-pre" id="contact-pre">Open to work · Collaborations · Research</p>
    <a href={`mailto:${personal.email}`} class="display contact-email">{personal.email}</a>
    <p class="mono contact-phone">{personal.phone}</p>
    <div class="contact-links">
      <a href={personal.linkedin} target="_blank" rel="noopener" class="mono contact-link">LinkedIn ↗</a>
      <a href={personal.github}   target="_blank" rel="noopener" class="mono contact-link">GitHub ↗</a>
    </div>
  </div>
</section>

<style>
.contact-block {
  padding: 3rem 2rem;
  border: 0.5px solid var(--border);
  border-radius: var(--radius);
  text-align: center;
  margin-bottom: 2rem;
  transition: border-color 0.2s, background 0.2s;
}
.contact-block:hover {
  border-color: var(--border-2);
  background: var(--bg-2);
}
.contact-pre {
  font-size: 11px;
  color: var(--ink-3);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  margin-bottom: 1rem;
}
.contact-email {
  display: block;
  font-size: clamp(20px, 3.5vw, 30px);
  font-weight: 800;
  letter-spacing: -0.02em;
  color: var(--ink);
  margin-bottom: 0.5rem;
  transition: color 0.15s;
}
.contact-email:hover { color: var(--accent); }
.contact-phone {
  font-size: 13px;
  color: var(--ink-2);
  margin-bottom: 1.5rem;
}
.contact-links {
  display: flex;
  justify-content: center;
  gap: 2rem;
}
.contact-link {
  font-size: 12px;
  color: var(--ink-2);
  transition: color 0.15s;
}
.contact-link:hover { color: var(--ink); }
@media (max-width: 640px) {
  .contact-email {
    font-size: 16px;
    word-break: break-all;
  }
}
</style>
