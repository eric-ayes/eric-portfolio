<section class="hero reveal">
  <p class="hero-tag mono" id="hero-tag">AI Engineer · Madrid</p>
  <h1 class="hero-headline display">
    <span id="hero-h1">I build things</span><br>
    <span class="hero-sub-word" id="hero-h2">that work.</span>
  </h1>
  <p class="hero-sub" id="hero-sub">
    Deep learning engineer with solid theoretical foundations.
    Computer vision, video, signal processing, LLMs and AI agents.
  </p>
  <p class="hero-inst mono" id="hero-inst">
    EHU · UAM · CIC biomaGUNE · Zitu Informatika.
  </p>
  <div class="hero-ctas">
    <a href="#projects" class="btn btn-primary" id="hero-cta">View projects</a>
    <a href="https://github.com/eric-ayes" target="_blank" rel="noopener" class="btn btn-ghost">GitHub ↗</a>
    <a href="https://www.linkedin.com/in/eric-ayestaran/" target="_blank" rel="noopener" class="btn btn-ghost">LinkedIn ↗</a>
  </div>
  <div class="hero-stack">
    <span class="mono stack-item">PyTorch</span>
    <span class="mono stack-item">Python</span>
    <span class="mono stack-item">Computer Vision</span>
    <span class="mono stack-item">LLMs & Agents</span>
    <span class="mono stack-item">MLOps</span>
    <span class="mono stack-item">Video Understanding</span>
    <span class="mono stack-item">Signal Processing</span>
  </div>
</section>

<style>
.hero { margin-bottom: 5rem; }

.hero-tag {
  font-size: 11px;
  color: var(--ink-3);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  margin-bottom: 1.25rem;
}

.hero-headline {
  font-size: clamp(38px, 6vw, 58px);
  font-weight: 800;
  line-height: 1.04;
  letter-spacing: -0.025em;
  margin-bottom: 1.5rem;
}
.hero-sub-word { color: var(--ink-2); }

.hero-sub {
  font-size: 15px;
  color: var(--ink-2);
  line-height: 1.65;
  max-width: 500px;
  margin-bottom: 0.75rem;
}

.hero-inst {
  font-size: 12px;
  color: var(--ink-3);
  letter-spacing: 0.06em;
  margin-bottom: 2rem;
}

.hero-ctas {
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
  margin-bottom: 3rem;
}

.hero-stack {
  display: flex;
  flex-wrap: wrap;
  gap: 1.25rem;
  padding-top: 2rem;
  border-top: 0.5px solid var(--border);
}
.stack-item {
  font-size: 11px;
  color: var(--ink-3);
  letter-spacing: 0.06em;
}
</style>